# crm-web environment — copy to .env.local (`cp .env.example .env.local`).
#
# ── Required ──────────────────────────────────────────────────────────────────
#
# CRM_API_URL — the backend every page reads from. There is no offline mode:
# unset, requests target "undefined/…" and the app is broken, which is
# deliberate (a missing backend must look broken, not empty). Point it at
# apps/crm-api-nest (NestJS, port 8001) — the only backend that serves this UI.
# apps/crm-api (FastAPI, port 8000) is the v1 teaching sandbox and is NOT
# UI-compatible; see AGENTS.md.
#
# Server-only (no NEXT_PUBLIC_ prefix), so the URL never reaches the browser
# bundle and the backend can stay on an internal network with no public route.
CRM_API_URL=http://localhost:8001

# The backend needs a migrated + seeded database before any page has content.
# From apps/crm-api-nest (once): bun run migrate && bun run seed
# See the repo README, "Running just the CRM stack".

# ── Optional ──────────────────────────────────────────────────────────────────
#
# Backend endpoints are auth-protected. With AUTH_MODE=local over there, crm-web
# auto-mints a bearer from /auth/token using CRM_DEV_USER/CRM_DEV_PASSWORD
# (default admin/admin — the user `bun run seed` creates) and re-mints on expiry,
# so there is no token to keep fresh. Override these only if you changed the
# backend's SEED_USER/SEED_PASSWORD. Set CRM_API_TOKEN to pin an explicit token
# instead (skips the auto-mint entirely).
# CRM_DEV_USER=admin
# CRM_DEV_PASSWORD=admin
# CRM_API_TOKEN=

# --- Authentik SSO (optional) -------------------------------------------------
# Leave these UNSET for local dev — the dashboard stays open, no login screen.
# Set them to enable Auth.js login; the user's Authentik access token is then
# forwarded to the backend (which must run with AUTH_MODE=oidc + matching
# OIDC_*). Get the values from: python3 scripts/setup-authentik-crm.py
#
# AUTH_SECRET=            # openssl rand -hex 32  (required when auth is enabled)
# AUTH_AUTHENTIK_ID=
# AUTH_AUTHENTIK_SECRET=
# AUTH_AUTHENTIK_ISSUER=http://localhost:9000/application/o/crm-dev/
