# Copy to .env and adjust. The defaults match the repo's docker-compose Postgres.

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/crm

# Local JWT auth (teaching default). Generate a real secret: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# "local" = username/password + local JWT.  "oidc" = validate Authentik tokens.
AUTH_MODE=local

# Authentik OIDC (only used when AUTH_MODE=oidc). Milestone — not yet implemented.
# OIDC_ISSUER=https://auth.example.com/application/o/crm/
# OIDC_AUDIENCE=your-authentik-client-id

# CORS — crm-web dev origin(s), comma-separated.
CORS_ORIGINS=http://localhost:3002

# Object storage for attachments — a Vietnamese S3 bucket (Bizfly / Viettel), so
# CRM documents never leave the country: a foreign bucket would make this a
# cross-border transfer under Luat BVDLCN 91/2025/QH15. Same bucket as
# crm-api-nest; both backends implement the presign endpoints.
# Unset, the API still runs — only the attachment endpoints answer 503, saying so.
S3_ENDPOINT=https://hcm.ss.bfcplatform.vn
S3_REGION=hcm
S3_BUCKET=greenorange
S3_ACCESS_KEY=
S3_SECRET_KEY=
